# Copy to .env and fill in. Never commit .env.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# true = Binance testnet (https://testnet.binance.vision) for LIVE_TRADING orders
EXCHANGE_USE_TESTNET=true

# PAPER_TRADING (default) or LIVE_TRADING
TRADING_MODE=PAPER_TRADING
SYMBOL=BTC/USDT
TIMEFRAME=1h
